<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>QuantumTrace</title>
<meta name="theme-color" content="#000000">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#000; --panel:#000; --line:#1f2a44;
  --text:#e8eaf0; --muted:#8f99b0; --dim:#566077;
  --purple:#3568d4; --deep:#1c3a7a; --lilac:#7fa6f0; --rose:#d63a45; --accent:#e0454f;
  --px:"Press Start 2P","Courier New",monospace;
  --body:"VT323","Courier New",ui-monospace,monospace;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*,*::before,*::after{box-sizing:border-box;border-radius:0}
body{margin:0;background:var(--bg);color:var(--text);font:22px/1.25 var(--body);min-height:100vh;display:flex;flex-direction:column}
.wrap{width:100%;max-width:960px;margin:0 auto;padding:0 20px}

/* pixel outline: hard 3px strips with the corners left out, so every box has notched corners */
.panel,.stage,.dialog,.btn,nav button,.blocks,.toast{
  --c:var(--line);
  border:3px solid transparent;
  box-shadow:0 -3px 0 0 var(--c),0 3px 0 0 var(--c),-3px 0 0 0 var(--c),3px 0 0 0 var(--c)}

/* header */
header{background:#000;border-bottom:3px solid var(--line);position:relative}
header::after{content:"";position:absolute;left:0;right:0;top:100%;height:8px;pointer-events:none;opacity:.4;
  background:conic-gradient(var(--purple) 25%,transparent 0 50%,var(--purple) 0 75%,transparent 0) 0 0/8px 8px}
.bar{display:flex;align-items:center;justify-content:space-between;height:68px;gap:12px}
.brand{display:flex;align-items:center;gap:12px;color:var(--text);text-decoration:none}
.brand svg{width:30px;height:30px;flex:none;shape-rendering:crispEdges}
.brand b{font:400 13px/1 var(--px);letter-spacing:.02em}
.brand b span{color:var(--accent)}
nav{display:flex;gap:10px}
nav button{--c:transparent;font:400 10px/1 var(--px);color:var(--muted);background:none;padding:11px 12px;cursor:pointer}
nav button:hover{--c:var(--line);color:var(--text)}
nav button.on{--c:var(--purple);background:var(--purple);color:#fff}

main{flex:1;padding:48px 0 64px}
.view[hidden]{display:none}
h1{font:400 clamp(17px,3.4vw,26px)/1.6 var(--px);margin:0;text-transform:uppercase}
h1 em{font-style:normal;color:var(--accent)}
.lead{color:var(--muted);max-width:560px;margin:16px 0 0;font-size:24px}
.label{font:400 9px/1 var(--px);color:var(--dim);text-transform:uppercase;letter-spacing:.04em}

/* buttons */
.btn{font:400 11px/1 var(--px);text-transform:uppercase;padding:15px 18px;cursor:pointer}
.btn:active{transform:translateY(3px)}
.btn.go{--c:var(--purple);background:var(--purple);color:#fff}
.btn.go:hover{background:#4a7ae0;--c:#4a7ae0}
.btn.alt{--c:var(--deep);background:transparent;color:var(--lilac)}
.btn.alt:hover{--c:var(--lilac);background:var(--lilac);color:#000}
:focus-visible{outline:3px solid var(--accent);outline-offset:5px}
.blink{animation:blink 1s steps(2,start) infinite}
@keyframes blink{to{visibility:hidden}}

/* upload */
.drop{margin-top:32px;border:3px dashed var(--line);padding:40px 24px;cursor:pointer}
.drop:hover,.drop.over{border-color:var(--accent);background:rgba(53,104,212,.08)}
.drop h3{margin:0;font:400 13px/1.6 var(--px);text-transform:uppercase}
.drop h3 i{font-style:normal;color:var(--accent)}
.drop p{margin:10px 0 0;color:var(--muted)}
.drop .row{display:flex;flex-wrap:wrap;gap:16px;margin-top:26px}
.formats{margin-top:20px;color:var(--dim);font-size:20px}

/* analysing */
.hud{display:grid;grid-template-columns:repeat(3,1fr);margin-top:28px}
.hud div{padding:12px 16px;border-right:3px solid var(--line)}
.hud div:last-child{border-right:0}
.hud b{display:block;margin-top:8px;font:400 15px/1 var(--px);color:var(--lilac)}
.bar2{margin-top:26px}
.bar2 .top{display:flex;justify-content:space-between;margin-bottom:10px}
.bar2 .top span:last-child{font:400 10px var(--px);color:var(--text)}
.blocks{display:grid;grid-template-columns:repeat(20,1fr);gap:3px;padding:5px;background:#000}
.blocks i{height:16px;background:#0d1220}
.blocks i.c1{background:#1c3a7a}.blocks i.c2{background:#3568d4}.blocks i.c3{background:#b83a48}.blocks i.c4{background:#e0454f}

.tablebox{--c:var(--deep);margin-top:30px;overflow:hidden}
.scroll{overflow-x:auto}
table{width:100%;border-collapse:collapse;min-width:620px}
th{font:400 9px/1 var(--px);color:var(--dim);text-align:left;padding:16px 16px 12px;border-bottom:3px solid var(--line);text-transform:uppercase}
td{padding:11px 16px;border-bottom:2px solid #141a2c;vertical-align:middle}
tr:last-child td{border-bottom:0}
th.r,td.r{text-align:right}
td.name::before{content:"■ ";color:var(--accent)}
.tag{display:inline-block;border:2px solid var(--deep);color:var(--lilac);font-size:19px;padding:0 8px;line-height:1.3}
.tag.dim{border-color:var(--line);color:var(--muted)}
td.size{color:var(--muted);white-space:nowrap}
.sha{font:400 18px var(--body);color:var(--muted);background:none;border:0;padding:0;cursor:pointer;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;text-align:left}
.sha:hover{color:var(--lilac)}
.pending{display:inline-block;width:80px;height:12px;background:repeating-linear-gradient(90deg,#151b30 0 8px,transparent 8px 12px)}

.stages{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:34px}
.stage{padding:14px}
.stage .n{font:400 9px/1 var(--px);color:var(--dim)}
.stage h4{margin:12px 0 4px;font:400 11px/1.4 var(--px);text-transform:uppercase}
.stage p{margin:0;color:var(--muted);font-size:19px;line-height:1.15}
.stage .st{display:block;margin-top:12px;font:400 9px/1 var(--px);color:var(--dim)}
.stage.done{--c:var(--lilac)}
.stage.done .n,.stage.done .st{color:var(--lilac)}
.stage.active{--c:var(--rose)}
.stage.active .n,.stage.active .st{color:var(--rose)}
.stage.lock{opacity:.55}

.dialog{--c:var(--rose);margin-top:34px;padding:18px 20px;position:relative}
.dialog h4{margin:0 0 10px;font:400 11px/1.5 var(--px);color:var(--rose);text-transform:uppercase}
.dialog p{margin:0;color:var(--text);font-size:21px;line-height:1.3;max-width:760px}
.dialog code{font:inherit;color:var(--lilac)}
.dialog .more{position:absolute;right:16px;bottom:10px;color:var(--rose);font-size:18px}
.actions{margin-top:36px}

.empty{margin-top:28px;padding:40px 24px;text-align:center}
.empty p{margin:0 0 24px;color:var(--muted)}

footer{border-top:3px solid var(--line);background:#000;padding:16px 0;color:var(--dim);font-size:19px}
footer .wrap{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.toast{--c:var(--lilac);position:fixed;left:50%;bottom:calc(22px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--lilac);color:#000;
  font:400 10px var(--px);padding:12px 14px;display:none;z-index:10;text-transform:uppercase}
.toast.show{display:block}

@media (max-width:720px){
  .stages{grid-template-columns:1fr 1fr}
  .hud b{font-size:12px}
  .brand b{font-size:11px}
  nav button{padding:10px 8px}
}
@media (max-width:480px){
  .wrap{padding:0 16px}
  .blocks i{height:12px}
  .hud div{padding:10px}
}
@media (prefers-reduced-motion:reduce){.blink{animation:none}}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <a class="brand" href="#" onclick="go('scan');return false" aria-label="QuantumTrace">
      <svg viewBox="0 0 10 10" aria-hidden="true">
        <path fill="#5b8def" d="M3 1h4v1H3zM2 2h1v1H2zM7 2h1v1H7zM1 3h1v4H1zM8 3h1v4H8zM2 7h1v1H2zM7 7h1v1H7zM3 8h4v1H3z"/>
        <path fill="#e0454f" d="M4 4h2v2H4z"/>
      </svg>
      <b>QUANTUM<span>TRACE</span></b>
    </a>
    <nav aria-label="Main">
      <button id="nav-scan" class="on" onclick="go('scan')">Scan</button>
      <button id="nav-reports" onclick="go('reports')">Reports</button>
    </nav>
  </div>
</header>

<main class="wrap">
  <section id="v-upload" class="view">
    <h1>Insert <em>files</em> to start</h1>
    <p class="lead">Find cryptography that a quantum computer could break. Drop captures, code, configs, certificates or cloud exports. Archives work too.</p>
    <div class="drop" id="drop" tabindex="0" role="button" aria-label="Choose files to analyse">
      <h3><i>▶</i> Drop files here<span class="blink">_</span></h3>
      <p>or pick them from your computer. Several at once is fine.</p>
      <div class="row">
        <button class="btn go" type="button" id="pick">Choose files</button>
        <button class="btn alt" type="button" id="demo">Try demo files</button>
      </div>
      <div class="formats">pcap · source code · nginx/ssh configs · PEM keys · cloud JSON · zip/tar</div>
      <input type="file" id="file" multiple hidden>
    </div>
  </section>

  <section id="v-run" class="view" hidden></section>

  <section id="v-reports" class="view" hidden>
    <h1>No reports <em>yet</em></h1>
    <div class="panel empty">
      <p>Finished scans will be saved here with their risk score and findings.</p>
      <button class="btn go" onclick="go('scan')">New scan</button>
    </div>
  </section>
</main>

<footer><div class="wrap"><span>QuantumTrace</span><span>JunctionX Lisbon 2026</span></div></footer>
<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
const $ = s => document.querySelector(s);
const esc = s => String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let batch = null;

function fmtBytes(n){ if(n<1024) return n+' B'; if(n<1048576) return (n/1024).toFixed(1)+' KB'; if(n<1073741824) return (n/1048576).toFixed(1)+' MB'; return (n/1073741824).toFixed(2)+' GB'; }
function fmtTime(d){ const p=n=>String(n).padStart(2,'0'); return `${d.getFullYear()}-${p(d.getMonth()+1)}-${p(d.getDate())} ${p(d.getHours())}:${p(d.getMinutes())}`; }
async function sha256(file){
  try{ if(!crypto?.subtle || file.size>256*1048576) return null;
    const h = await crypto.subtle.digest('SHA-256', await file.arrayBuffer());
    return [...new Uint8Array(h)].map(b=>b.toString(16).padStart(2,'0')).join('');
  }catch(e){ return null; }
}
async function detect(file){
  const h = new Uint8Array(await file.slice(0,16).arrayBuffer());
  const n = file.name.toLowerCase(), ext = n.includes('.') ? n.split('.').pop() : '';
  const is = (...b) => b.every((v,i)=>h[i]===v);
  if (is(0x50,0x4b,0x03,0x04) || is(0x1f,0x8b) || is(0x42,0x5a,0x68) || is(0xfd,0x37,0x7a,0x58)) return 'Archive';
  if (is(0xd4,0xc3,0xb2,0xa1) || is(0xa1,0xb2,0xc3,0xd4) || is(0x4d,0x3c,0xb2,0xa1) || is(0xa1,0xb2,0x3c,0x4d) || is(0x0a,0x0d,0x0d,0x0a)) return 'Network capture';
  if (new TextDecoder().decode(h).startsWith('-----BEGIN')) return 'Certificate / key';
  if (['zip','tar','tgz','gz','bz2','xz','jar'].includes(ext)) return 'Archive';
  if (['pcap','pcapng','cap'].includes(ext)) return 'Network capture';
  if (['pem','crt','cer','key','der','csr','pub','p12','pfx'].includes(ext)) return 'Certificate / key';
  if (['py','java','kt','scala','go','js','ts','jsx','tsx','c','h','cpp','cc','hpp','cs','php','rb','rs'].includes(ext)) return 'Source code';
  if (['conf','cnf','ini','yaml','yml','properties','env','tf','toml','cfg'].includes(ext) || /sshd?_config|ssh_config|haproxy|nginx|httpd/.test(n)) return 'Configuration';
  if (ext==='json') return 'Cloud export';
  return 'Other file';
}

function go(view){
  $('#nav-scan').classList.toggle('on', view==='scan');
  $('#nav-reports').classList.toggle('on', view==='reports');
  $('#v-reports').hidden = view!=='reports';
  $('#v-upload').hidden = view!=='scan' || !!batch;
  $('#v-run').hidden = view!=='scan' || !batch;
  window.scrollTo({top:0});
}

async function ingest(list){
  const files = [...list]; if(!files.length) return;
  batch = { started:new Date(), phase:1, files: files.map(f=>({name:f.name,size:f.size,type:null,sha:null,ready:false})) };
  render(); go('scan');
  await Promise.all(files.map(async (f,i)=>{
    const [type, sha] = await Promise.all([detect(f), sha256(f)]);
    Object.assign(batch.files[i], {type, sha, ready:true}); render();
  }));
  await new Promise(r=>setTimeout(r,400));
  batch.phase = 2; render();
}
function demoFiles(){
  const pad = (head, size) => { const b = new Uint8Array(size); b.set(head); for(let i=head.length;i<size;i++) b[i]=(i*31+7)&255; return b; };
  return [
    new File([pad([0x50,0x4b,0x03,0x04],5632)], 'bundle.zip'),
    new File([pad([0xd4,0xc3,0xb2,0xa1],203981)], 'capture.bin'),
    new File(['server {\n  listen 443 ssl;\n  ssl_protocols TLSv1.2;\n  ssl_ciphers AES128-SHA;\n}\n'.padEnd(160,' ')], 'nginx.conf')
  ];
}

function render(){
  if(!batch) return;
  const n = batch.files.length;
  const total = batch.files.reduce((a,f)=>a+f.size,0);
  const done = batch.files.filter(f=>f.ready).length;
  const ready = done===n;
  const waiting = ready && batch.phase===2;

  // loading bar: 20 blocks. received = 5, identified adds up to 5 more, scanning is still empty.
  const filled = 5 + Math.round(5*done/n);
  const blocks = Array.from({length:20},(_,i)=> i<filled ? `<i class="c${Math.floor(i/5)+1}"></i>` : '<i></i>').join('');

  const stages = [['Received','Files stored for analysis'],['Identified','File types and SHA-256 computed'],['Scanning','Waiting for the scanner'],['Report','Risk score and findings']];
  const state = i => i===0 ? 'done' : i===1 ? (ready?'done':'active') : i===2 ? (waiting?'active':'lock') : 'lock';
  const stLabel = {done:'CLEAR ✓', active:'IN PROGRESS', lock:'LOCKED'};

  const rows = batch.files.map(f=>`
    <tr>
      <td class="name">${esc(f.name)}</td>
      <td>${f.ready ? `<span class="tag ${f.type==='Other file'?'dim':''}">${esc(f.type)}</span>` : '<span class="pending"></span>'}</td>
      <td class="r size">${fmtBytes(f.size)}</td>
      <td>${f.ready ? (f.sha ? `<button class="sha" title="${f.sha} (click to copy)" data-sha="${f.sha}">${f.sha}</button>` : '<span class="size">not computed</span>') : '<span class="pending" style="width:160px"></span>'}</td>
    </tr>`).join('');

  $('#v-run').innerHTML = `
    <h1>Analysing <em>${n}</em> file${n>1?'s':''}</h1>
    <div class="panel hud">
      <div><span class="label">Files</span><b>${String(n).padStart(2,'0')}</b></div>
      <div><span class="label">Size</span><b>${fmtBytes(total)}</b></div>
      <div><span class="label">Started</span><b>${fmtTime(batch.started).slice(11)}</b></div>
    </div>

    <div class="bar2">
      <div class="top"><span class="label">${waiting ? 'Waiting for scanner' : 'Preparing files'}</span><span>${filled*5}%</span></div>
      <div class="blocks" aria-hidden="true">${blocks}</div>
    </div>

    <div class="panel tablebox"><div class="scroll"><table>
      <thead><tr><th>Name</th><th>Type</th><th class="r">Size</th><th>SHA-256</th></tr></thead>
      <tbody>${rows}</tbody></table></div></div>

    <div class="stages">${stages.map((s,i)=>{ const st=state(i); return `<div class="stage ${st}"><span class="n">STAGE ${i+1}/4</span><h4>${s[0]}</h4><p>${s[1]}</p><span class="st ${st==='active'?'blink':''}">${stLabel[st]}</span></div>`; }).join('')}</div>

    ${waiting ? `<div class="dialog">
      <h4>! Scanner not connected yet</h4>
      <p>The files are ready and will be sent as soon as the scan function is plugged in. Set <code>QT_BACKEND=module:function</code> (Python) or <code>QT_BACKEND_URL=http://…/scan</code> (HTTP) and start the dashboard again. See <code>CONTRATO.md</code> for the result format.</p>
      <span class="more blink">▼</span>
    </div>` : ''}

    <div class="actions"><button class="btn alt" id="again">Scan other files</button></div>`;
  $('#again').onclick = () => { batch=null; $('#file').value=''; go('scan'); };
  document.querySelectorAll('.sha').forEach(b => b.onclick = () => copy(b.dataset.sha));
  go($('#nav-reports').classList.contains('on') ? 'reports' : 'scan');
}

function copy(t){
  (navigator.clipboard?.writeText(t) || Promise.reject()).then(()=>toast('Hash copied')).catch(()=>toast('Copy failed'));
}
let tt; function toast(m){ const el=$('#toast'); el.textContent=m; el.classList.add('show'); clearTimeout(tt); tt=setTimeout(()=>el.classList.remove('show'),1400); }

const drop = $('#drop'), input = $('#file');
$('#pick').onclick = e => { e.stopPropagation(); input.click(); };
$('#demo').onclick = e => { e.stopPropagation(); ingest(demoFiles()); };
drop.onclick = () => input.click();
drop.onkeydown = e => { if(e.key==='Enter'||e.key===' '){ e.preventDefault(); input.click(); } };
input.onchange = () => ingest(input.files);
['dragenter','dragover'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.add('over'); }));
['dragleave','drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.remove('over'); }));
drop.addEventListener('drop', e => ingest(e.dataTransfer.files));
window.addEventListener('dragover', e => e.preventDefault());
window.addEventListener('drop', e => e.preventDefault());
</script>
</body>
</html>
